[Unit]
Description=GensokyoGeoGuesser Neo (dev, Gunicorn)
After=network.target

[Service]
Type=simple
User=priv
Group=priv
WorkingDirectory=/home/priv/apps/GensokyoGeoGuesser
ExecStart=/home/priv/apps/GensokyoGeoGuesser/.venv/bin/python -m gunicorn --chdir /home/priv/apps/GensokyoGeoGuesser --workers 1 --worker-class gthread --threads 32 --bind 127.0.0.1:20811 --timeout 0 --access-logfile - --error-logfile - app:create_app()
Restart=on-failure
RestartSec=5
MemoryHigh=320M
MemoryMax=448M
MemorySwapMax=128M
TasksMax=128

# Keep stdout/stderr in journald for `journalctl -u ggg-neo`.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

