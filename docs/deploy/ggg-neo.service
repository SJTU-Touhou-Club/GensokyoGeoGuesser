[Unit]
Description=GensokyoGeoGuesser Neo Flask Service
After=network.target

[Service]
Type=simple
User=priv
Group=priv
WorkingDirectory=/home/priv/apps/GensokyoGeoGuesser
ExecStart=/home/priv/apps/GensokyoGeoGuesser/.venv/bin/python app.py --port 20811
Restart=on-failure
RestartSec=5

# Keep stdout/stderr in journald for `journalctl -u ggg-neo`.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

